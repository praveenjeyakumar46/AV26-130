# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Ollama LLM Configuration
# If Ollama runs on another machine/container, point this to that host.
OLLAMA_BASE_URL=http://localhost:11434
# Main model used for answer generation
OLLAMA_MODEL=qwen2.5:7b
# Smaller/faster model used for intent/keyword work
OLLAMA_MISTRAL_MODEL=qwen2.5:3b

# Local faster-whisper (run: python whisper_server.py) — primary STT; uses CUDA if WHISPER_DEVICE=cuda and drivers match.
WHISPER_URL=http://127.0.0.1:9000
# Python only (whisper_server.py): WHISPER_MODEL=medium  WHISPER_DEVICE=cuda  WHISPER_COMPUTE_TYPE=float16

# Google Cloud Speech-to-Text (optional fallback if Whisper is down or returns empty)
# GOOGLE_SPEECH_API_KEY=your_api_key_here
# GOOGLE_SPEECH_MODEL=latest_short
# GOOGLE_SPEECH_SAMPLE_RATE_HZ=48000
# GOOGLE_SPEECH_USE_ENHANCED=false
# OPENAI_API_KEY=
