{
  "name": "legal-ai-backend",
  "version": "1.0.0",
  "description": "Production-ready Express.js backend with TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:load-csv": "node database/scripts/load_constitution_csv.js",
    "db:load-constitution-india-csv": "node database/scripts/load_constitution_of_india_csv.js",
    "db:load-json": "node database/scripts/load_constitution_json.js",
    "db:load-all": "npm run db:load-csv && npm run db:load-json",
    "db:load-acts": "node database/scripts/load_central_acts.js",
    "db:load-constitution-pdfs": "node database/scripts/load_constitution_pdfs.js",
    "db:load-all-docs": "npm run db:load-acts && npm run db:load-constitution-pdfs",
    "db:retry-constitution": "node database/scripts/retry_failed_constitution.js",
    "db:verify": "node database/scripts/verify_data.js"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "@types/multer": "^2.0.0",
    "axios": "^1.13.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.5.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
